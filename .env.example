# ============================================================
# MYVOICE — ENVIRONMENT CONFIGURATION (.env)
# Copy this file to ".env" in the project root and fill in the
# real values. Secrets are loaded from the environment only —
# they are never hard-coded in source code.
#
# IMPORTANT: Read the developer security email / SMTP settings
# from THIS file or your server environment. Never commit a
# real .env containing credentials to version control.
# ============================================================

# --- Developer securities email (recipient of recovery notifications) ---
# The authorized developer / security contact that receives emergency
# recovery request notifications.
MYVOICE_SECURITY_EMAIL=security@example.com

# --- SMTP settings (used by modules/emailer.py) ---
# To deliver recovery notifications by email, configure a working SMTP server
# (for Gmail, use an app password and host smtp.gmail.com).
# If MYVOICE_SMTP_HOST is empty, notifications are written to the secure
# server log instead (development fallback).
MYVOICE_SMTP_HOST=
MYVOICE_SMTP_PORT=587
MYVOICE_SMTP_USER=
MYVOICE_SMTP_PASSWORD=
MYVOICE_SMTP_FROM=

# --- Application secret key (session signing) ---
# Set a long, random value in production.
# MYVOICE_SECRET_KEY=

# --- Initial administrator provisioning ---
# Set this only when creating the first administrator on a new database.
# Never commit the real value.
# MYVOICE_INITIAL_ADMIN_PASSWORD=